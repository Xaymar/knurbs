# OBS CMake macOS build dependencies module

include_guard(GLOBAL)

include(buildspec_common)

# _is_macho_file: Check whether a file is a Mach-O binary (thin or fat) or a static library archive
function(_is_macho_file file_path variable_name)
  set(${variable_name} FALSE)

  file(READ "${file_path}" magic LIMIT 8 HEX)
  # 64-bit Mach-O (little and big endian), fat binaries (32 and 64-bit) and ar archives ("!<arch>\n")
  if(magic MATCHES "^(cffaedfe|feedfacf|cafebabe|cafebabf)" OR magic STREQUAL "213c617263683e0a")
    set(${variable_name} TRUE)
  endif()

  return(PROPAGATE ${variable_name})
endfunction()

# _merge_universal_cef: Merge the arm64 and x86_64 CEF distributions into a single universal distribution
#
# CEF does not provide universal binaries, so every Mach-O file (the framework, its helper libraries and the static
# wrapper and sandbox libraries) is combined with lipo. Architecture-specific resources (e.g. the V8 snapshots) carry
# the architecture in their file name and are simply copied side by side.
function(_merge_universal_cef arm64_dir x86_64_dir universal_dir)
  set(stamp_file "${universal_dir}/.knurbs-universal-stamp")

  file(READ "${dependencies_dir}/.dependency_cef_arm64.sha256" arm64_hash)
  file(READ "${dependencies_dir}/.dependency_cef_x86_64.sha256" x86_64_hash)
  set(stamp "2;${arm64_hash};${x86_64_hash}")

  if(EXISTS "${stamp_file}")
    file(READ "${stamp_file}" existing_stamp)
    if(existing_stamp STREQUAL stamp)
      message(STATUS "Setting up Chromium Embedded Framework (universal) - skipped")
      return()
    endif()
  endif()

  message(STATUS "Setting up Chromium Embedded Framework (universal)")

  file(REMOVE_RECURSE "${universal_dir}")
  # ditto keeps the framework's symbolic links and extended attributes intact
  execute_process(COMMAND ditto "${arm64_dir}" "${universal_dir}" COMMAND_ERROR_IS_FATAL ANY)

  file(GLOB_RECURSE x86_64_files LIST_DIRECTORIES FALSE RELATIVE "${x86_64_dir}" "${x86_64_dir}/*")

  set(merged_count 0)
  foreach(relative_path IN LISTS x86_64_files)
    set(x86_64_file "${x86_64_dir}/${relative_path}")
    set(universal_file "${universal_dir}/${relative_path}")

    if(IS_SYMLINK "${x86_64_file}")
      if(NOT EXISTS "${universal_file}" AND NOT IS_SYMLINK "${universal_file}")
        cmake_path(GET universal_file PARENT_PATH universal_parent)
        file(MAKE_DIRECTORY "${universal_parent}")
        execute_process(COMMAND cp -P "${x86_64_file}" "${universal_file}" COMMAND_ERROR_IS_FATAL ANY)
      endif()
      continue()
    endif()

    if(NOT EXISTS "${universal_file}")
      cmake_path(GET universal_file PARENT_PATH universal_parent)
      file(MAKE_DIRECTORY "${universal_parent}")
      execute_process(COMMAND ditto "${x86_64_file}" "${universal_file}" COMMAND_ERROR_IS_FATAL ANY)
      continue()
    endif()

    _is_macho_file("${x86_64_file}" is_macho)
    if(is_macho)
      execute_process(
        COMMAND lipo -create "${universal_file}" "${x86_64_file}" -output "${universal_file}.universal"
        RESULT_VARIABLE lipo_result
        ERROR_VARIABLE lipo_error
      )
      if(NOT lipo_result EQUAL 0)
        message(FATAL_ERROR "Unable to create universal binary for CEF file ${relative_path}: ${lipo_error}")
      endif()
      file(RENAME "${universal_file}.universal" "${universal_file}")
      math(EXPR merged_count "${merged_count} + 1")
    else()
      file(SHA256 "${universal_file}" arm64_file_hash)
      file(SHA256 "${x86_64_file}" x86_64_file_hash)
      if(NOT arm64_file_hash STREQUAL x86_64_file_hash)
        if(relative_path MATCHES "\\.h$")
          # Generated headers such as include/cef_api_versions.h carry per-architecture API hashes: keep both
          # versions and pick the matching one at compile time.
          cmake_path(GET relative_path STEM header_stem)
          cmake_path(GET relative_path FILENAME header_name)
          cmake_path(GET universal_file PARENT_PATH header_dir)
          file(RENAME "${universal_file}" "${header_dir}/${header_stem}.arm64.h")
          file(COPY_FILE "${x86_64_file}" "${header_dir}/${header_stem}.x86_64.h")
          file(
            WRITE "${universal_file}"
            "// Generated by Knurbs: ${header_name} differs between the arm64 and x86_64 CEF distributions.\n"
            "#if defined(__arm64__) || defined(__aarch64__)\n"
            "#include \"${header_stem}.arm64.h\"\n"
            "#elif defined(__x86_64__)\n"
            "#include \"${header_stem}.x86_64.h\"\n"
            "#else\n"
            "#error \"Unsupported architecture for the universal CEF distribution\"\n"
            "#endif\n"
          )
          message(STATUS "CEF header ${relative_path} differs between architectures - selecting it per architecture")
        elseif(NOT relative_path STREQUAL "README.txt")
          message(
            AUTHOR_WARNING
            "CEF file ${relative_path} differs between arm64 and x86_64 and is not a binary or header - using the arm64 version."
          )
        endif()
      endif()
    endif()
  endforeach()

  if(merged_count EQUAL 0)
    message(FATAL_ERROR "No Mach-O binaries found to merge in the CEF distribution at ${x86_64_dir}")
  endif()

  # lipo drops the slices' code signatures - re-sign ad-hoc so the framework stays loadable for local builds. Release
  # builds re-sign the framework with the real identity when it is embedded into the application bundle.
  file(
    GLOB cef_frameworks
    LIST_DIRECTORIES TRUE
    "${universal_dir}/Release/*.framework"
    "${universal_dir}/Debug/*.framework"
  )
  foreach(framework IN LISTS cef_frameworks)
    if(IS_DIRECTORY "${framework}")
      execute_process(
        COMMAND codesign --force --deep --sign - "${framework}"
        OUTPUT_QUIET
        ERROR_QUIET
      )
    endif()
  endforeach()

  file(WRITE "${stamp_file}" "${stamp}")
  message(STATUS "Setting up Chromium Embedded Framework (universal) - done (${merged_count} binaries merged)")
endfunction()

# _check_dependencies_macos: Set up macOS slice for _check_dependencies
function(_check_dependencies_macos)
  set(arch universal)
  set(platform macos-${arch})

  set(dependencies_dir "${CMAKE_CURRENT_SOURCE_DIR}/.deps")
  set(prebuilt_filename "macos-deps-VERSION-ARCH-REVISION.tar.xz")
  set(prebuilt_destination "obs-deps-VERSION-ARCH")
  set(qt6_filename "macos-deps-qt6-VERSION-ARCH-REVISION.tar.xz")
  set(qt6_destination "obs-deps-qt6-VERSION-ARCH")
  set(cef_filename "cef_binary_VERSION_macos_ARCH_REVISION.tar.xz")
  set(cef_destination "cef_binary_VERSION_macos_ARCH")
  set(dependencies_list prebuilt qt6 cef)

  _check_dependencies(${dependencies_list})

  # obs-deps and Qt are universal already, CEF has to be merged from its single-architecture distributions
  list(LENGTH CMAKE_OSX_ARCHITECTURES architecture_count)
  if(ENABLE_BROWSER AND architecture_count GREATER 1)
    if(NOT "arm64" IN_LIST CMAKE_OSX_ARCHITECTURES OR NOT "x86_64" IN_LIST CMAKE_OSX_ARCHITECTURES)
      message(FATAL_ERROR "Universal builds with browser support require exactly arm64 and x86_64 architectures.")
    endif()

    foreach(cef_arch IN ITEMS arm64 x86_64)
      _check_dependencies(cef)
    endforeach()
    unset(cef_arch)

    _get_dependency_data(dependency_data)
    string(JSON cef_version GET ${dependency_data} cef version)
    set(cef_base "${dependencies_dir}/cef_binary_${cef_version}_macos")

    _merge_universal_cef("${cef_base}_arm64" "${cef_base}_x86_64" "${cef_base}_universal")
    set(CEF_ROOT_DIR "${cef_base}_universal" CACHE PATH "CEF root directory" FORCE)
  endif()

  execute_process(
    COMMAND "xattr" -r -d com.apple.quarantine "${dependencies_dir}/${destination}"
    RESULT_VARIABLE result
    COMMAND_ERROR_IS_FATAL ANY
  )
endfunction()

_check_dependencies_macos()
